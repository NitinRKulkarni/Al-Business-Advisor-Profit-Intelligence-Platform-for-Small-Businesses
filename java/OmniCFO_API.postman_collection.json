								"key": "X-Tenant-ID",
								"value": "{{tenantId}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/files?fileType=Invoice",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "files"],
							"query": [
								{
									"key": "fileType",
									"value": "Invoice",
									"description": "Filter by fileType: Invoice, WhatsAppChat, BankStmt, or Inventory"
								}
							]
						},
						"description": "Fetches uploaded documents filtered by fileType, ordered by newest first."
					},
					"response": []
