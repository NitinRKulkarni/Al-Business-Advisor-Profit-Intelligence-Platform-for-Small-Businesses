				{
					"name": "6. List All Documents (200 OK)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-Tenant-ID",
								"value": "{{tenantId}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/files",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "files"]
						},
						"description": "Fetches all uploaded documents and their processing statuses for the tenant, ordered by newest first."
					},
					"response": []
