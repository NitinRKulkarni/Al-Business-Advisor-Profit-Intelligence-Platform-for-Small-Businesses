	"item": [
		{
			"name": "Organizations (Tenants)",
			"item": [
				{
					"name": "1. List All Organizations",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/organizations",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "organizations"]
						},
						"description": "Fetches all initialized organizations/tenants."
					},
					"response": []
				},
				{
					"name": "2. Create New Organization",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"businessName\": \"Apex Tech Solutions\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/organizations",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "organizations"]
						},
						"description": "Creates a new tenant organization."
					},
					"response": []
				}
			]
		},
		{
			"name": "Document Ingestion",
			"item": [
				{
					"name": "1. Upload Invoice File (201 Created)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "X-Tenant-ID",
								"value": "{{tenantId}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "file",
									"type": "file",
									"src": []
								},
								{
									"key": "fileType",
									"value": "Invoice",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/files/upload",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "files", "upload"]
						},
						"description": "Upload an invoice file (PDF, PNG, CSV) with X-Tenant-ID header."
					},
					"response": []
				},
				{
